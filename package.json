{
  "name": "hn-job-fetcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:client": "node --check public/app.js",
    "check": "npm run typecheck && npm run check:client && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "entities": "8.0.0",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/sanitize-html": "2.16.1",
    "typescript": "7.0.2"
  }
}
